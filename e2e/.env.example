# Copy to e2e/.env (gitignored) and fill in. Shell variables win over this file.
# Every variable is optional; see README.md for what each one does.

# Which deployment to test: dev (Base Sepolia, default) or local (Hardhat 31337).
E2E_TARGET=dev

# URL of an already running UI, e.g. your own `npm run dev` (http://localhost:3001).
# Leave empty to let Playwright start `vite` from ../ui on E2E_UI_PORT with
# APP_ENV=$E2E_TARGET (and stop it after the run).
E2E_BASE_URL=
E2E_UI_PORT=3101

# Chain the mock wallet signs for. Empty = the UI's own config
# (REACT_APP_READ_ONLY_ETH_NODE_URL / REACT_APP_CHAIN_ID), then
# https://sepolia.base.org (dev) or http://127.0.0.1:8545 (local).
E2E_RPC_URL=
E2E_CHAIN_ID=

# Private key of a DEDICATED test wallet (0x + 64 hex chars). Never a real one.
# dev: needs Base Sepolia ETH for gas and the dev collateral token (USDC).
# Empty = a throwaway key is generated; tests that need funds are skipped.
E2E_WALLET_PRIVATE_KEY=

# Keep amounts small. All USDC amounts are human units (5 = 5 USDC).
E2E_DEPOSIT_AMOUNT=5
E2E_WITHDRAW_AMOUNT=1
E2E_ORDER_QTY=1
E2E_PRICE_OFFSET_PCT=3
# Order specs top the vault up to this much collateral before trading.
E2E_MIN_COLLATERAL=25

# Whether the subgraph for this target is reachable. Defaults: dev=true, local=false.
# Order book, orders, positions and history all come from the subgraph.
E2E_SUBGRAPH=

# Comma-separated regexes for console errors to ignore entirely. Uncaught page
# errors and failed "[web3][read]" calls fail the smoke test; everything else is
# only attached to the report. e.g. getMarketPrice,minimumPriceIncrement
E2E_CONSOLE_ERROR_ALLOWLIST=

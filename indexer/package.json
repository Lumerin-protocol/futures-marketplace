{
  "name": "futures",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf data generated build",
    "codegen": "graph codegen",
    "//prepare:env": "`.` searches PATH when its operand has no slash, so a bare filename must be made explicitly relative for dash, which is /bin/sh on the CI runners.",
    "prepare:env": "ENV_FILE=\"${ENV_FILE:?ENV_FILE must point at an env file, e.g. ../config/dev.env}\"; case \"$ENV_FILE\" in */*) ;; *) ENV_FILE=\"./$ENV_FILE\" ;; esac; set -a && . \"$ENV_FILE\" && set +a && envsubst < subgraph.template.yaml > subgraph.yaml",
    "prepare-local": "ENV_FILE=../config/dev.env pnpm prepare:env",
    "build": "graph build",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ futures",
    "create-local": "graph create --node http://localhost:8020/ futures",
    "remove-local": "graph remove --node http://localhost:8020/ futures",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 --version-label 0 futures",
    "setup-local": "pnpm prepare-local && pnpm codegen && pnpm build && pnpm create-local && pnpm deploy-local",
    "test": "pnpm test:integration",
    "test:unit": "graph test",
    "indexer": "docker compose --env-file ../config/dev.env --env-file ../.env up",
    "test:integration": "hardhat test nodejs",
    "test:integration:debug": "MATCHSTICK_VERBOSE=true hardhat test nodejs",
    "typecheck": "tsgo --noEmit -p integration/tsconfig.json",
    "lint": "biome lint .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@graphprotocol/graph-ts": "0.37.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@graphprotocol/graph-cli": "^0.98.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.17",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "assemblyscript": "^0.19.23",
    "futures-contracts": "link:../contracts",
    "hardhat": "^3.9.1",
    "hardhat-matchstick-ts": "github:lsheva/matchstick-ts#v0.4.2&path:packages/hardhat-matchstick-ts",
    "matchstick-as": "0.6.0",
    "matchstick-ts": "github:lsheva/matchstick-ts#v0.4.2&path:packages/matchstick-ts",
    "typescript": "^5.9.3",
    "yaml": "^2.5.0"
  },
  "packageManager": "pnpm@11.22.0"
}

{
  "name": "futures",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean": "rm -rf data generated build",
    "codegen": "graph codegen",
    "prepare:env": "envsubst < subgraph.template.yaml > subgraph.yaml",
    "prepare-local": "set -a && source ../.env && set +a && envsubst < subgraph.template.yaml > subgraph.yaml",
    "build": "graph build",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ futures",
    "create-local": "graph create --node http://localhost:8020/ futures",
    "remove-local": "graph remove --node http://localhost:8020/ futures",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 --version-label 0 futures",
    "setup-local": "pnpm prepare-local && pnpm codegen && pnpm build && pnpm create-local && pnpm deploy-local",
    "test": "pnpm test:integration",
    "test:unit": "graph test",
    "indexer": "docker-compose up",
    "test:integration": "hardhat test nodejs",
    "test:integration:debug": "MATCHSTICK_VERBOSE=true hardhat test nodejs"
  },
  "dependencies": {
    "@graphprotocol/graph-ts": "0.37.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "viem": "^2.37.9"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.8",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.8",
    "@nomicfoundation/hardhat-viem": "^3.0.7",
    "@types/node": "^25.9.1",
    "assemblyscript": "^0.19.23",
    "futures-contracts": "link:../contracts",
    "hardhat": "^3.4.0",
    "hardhat-matchstick-ts": "github:lsheva/matchstick-ts#6c7e4b5d584a9fc75b66d1f6c03820e20313c9ad&path:packages/hardhat-matchstick-ts",
    "matchstick-as": "0.6.0",
    "matchstick-ts": "github:lsheva/matchstick-ts#6c7e4b5d584a9fc75b66d1f6c03820e20313c9ad&path:packages/matchstick-ts",
    "typescript": "^5.9.3",
    "yaml": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "matchstick-ts@https://codeload.github.com/lsheva/matchstick-ts/tar.gz/6c7e4b5d584a9fc75b66d1f6c03820e20313c9ad#path:packages/matchstick-ts",
      "hardhat-matchstick-ts@https://codeload.github.com/lsheva/matchstick-ts/tar.gz/6c7e4b5d584a9fc75b66d1f6c03820e20313c9ad#path:packages/hardhat-matchstick-ts"
    ]
  }
}
{
  "name": "futures-contracts",
  "version": "1.0.0",
  "type": "module",
  "author": "Oleksandr Shevchuk <shev@titan.io>",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./abi/*": "./abi/*.ts",
    "./test-api": "./src/test-api/index.ts"
  },
  "scripts": {
    "format:sol": "forge fmt ./contracts/**/*.sol",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsgo --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf abi artifacts cache",
    "deploy:futures": "hardhat run scripts/deploy-futures.ts",
    "deploy:local": "hardhat run scripts/deploy-local.ts",
    "upgrade:futures": "hardhat run scripts/update-futures.ts",
    "futures:close": "hardhat run scripts/futures-close.ts",
    "futures:reset-state": "hardhat run scripts/futures-reset-state.ts",
    "set:btc-price": "hardhat run scripts/set-bitcoin-price.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.0.17",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.2",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "hardhat": "^3.9.1",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "multicall3@0.0.0": "patches/multicall3@0.0.0.patch"
    }
  },
  "dependencies": {
    "@chainlink/contracts": "^1.3.0",
    "@noble/curves": "^1.6.0",
    "@openzeppelin/contracts": "5.1.0",
    "@openzeppelin/contracts-upgradeable": "5.1.0",
    "@safe-global/api-kit": "^5.0.1",
    "@safe-global/protocol-kit": "^8.0.4",
    "@safe-global/types-kit": "^4.0.1",
    "collateral-margin": "link:../../collateral-margin",
    "multicall3": "github:mds1/multicall3",
    "solidity-linked-list": "6.5.0",
    "viem": "^2.54.6"
  },
  "packageManager": "pnpm@10.28.1"
}

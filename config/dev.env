REACT_APP_PAYMENT_SLIPPAGE_PERCENT=1
REACT_APP_PERPS_TOKEN_ADDRESS=0x0d412BC34a48e434144687Aac03b9C593F5237B6
REACT_APP_SUBGRAPH_FUTURES_URL=https://api.goldsky.com/api/public/project_cmmz59uoa7b5201wthnkxbuqy/subgraphs/hpow-futures/dev-latest/gn

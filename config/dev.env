# Public, per-environment values for DEV (base-sepolia).
#
# Loaded by Hardhat (`--env dev`), the UI (`--env-file`), the subgraph
# renderer (`ENV_FILE`), notifications, and the deploy workflows, which
# build the ECS environment block from the keys in this file.
#
# Never put secrets here. Those live in the repo-root `.env` locally and in
# GitHub Secrets in CI, and both take precedence over this file.
#
# Values are unquoted on purpose: `docker run --env-file` does not strip quotes
# in every CLI version, unlike Node, bash, and Compose.

NETWORK=base-sepolia

# ── Contracts ──────────────────────────────────────────────────────────────
COLLATERAL_TOKEN_ADDRESS=0xdd15eed84065a58c9e9ff9e95fb996be0fff22aa
FUTURES_ADDRESS=0x56d8d4a03a0f34b93B86E0b7941aFF29178D0479
POINTS_HOOK_ADDRESS=0x99c28ff216a80e1a14ff276775ec458150979959
PERPS_ADDRESS=0x0d412BC34a48e434144687Aac03b9C593F5237B6
PME_ADDRESS=0x3899e429Ef47140eC46c6E23F04253C24F221b69
POINTS_ADDRESS=0x153F6cb4386d717AD94791E6Ee8ae37f80315972
VAULT_ADDRESS=0x54A79e2a5C60ACe37b280eBbCda51b4E903d25F0
SAFE_OWNER_ADDRESS=

# ── Subgraph manifests ─────────────────────────────────────────────────────
START_BLOCK_FUTURES=45600575

# ── Notifications runtime ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── UI (local `pnpm dev` / `pnpm build:dev`; CI overlays URL and secrets) ──
REACT_APP_CHAIN_ID=84532
REACT_APP_ETHERSCAN_URL=https://sepolia.basescan.org
REACT_APP_FUTURES_TOKEN_ADDRESS=0x56d8d4a03a0f34b93b86e0b7941aff29178d0479
REACT_APP_GITBOOK_URL=https://gitbook.hashpower.io
REACT_APP_MARKET_MAKER_ADDRESS=0x6396355A481d8a59fb6436B9290C4602aD3a9174

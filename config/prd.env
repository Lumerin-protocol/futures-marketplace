# Public, per-environment values for PRD (base mainnet).
#
# Loaded by Hardhat (`--env prd`), the UI (`--env-file`), the subgraph
# renderer (`ENV_FILE`), notifications, and the deploy workflows, which
# build the ECS environment block from the keys in this file.
#
# GitHub Environments `stg` and `main` both map to this file. `base` is the
# Graph manifest name, the viem chain key, and Hardhat's canonical network
# name. Hardhat still accepts the older `base-mainnet` spelling as a
# deprecated alias.
#
# Never put secrets here. Those live in the repo-root `.env` locally and in
# GitHub Secrets in CI, and both take precedence over this file.
#
# Values are unquoted on purpose: `docker run --env-file` does not strip quotes
# in every CLI version, unlike Node, bash, and Compose.

NETWORK=base
# ── Contracts ──────────────────────────────────────────────────────────────
COLLATERAL_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
FUTURES_ADDRESS=0xf97a1bbfb5e061ef73dad8ebf25939d93639fb7f
PERPS_ADDRESS=0x794f9e63b7666985256f1d2763ee24cc0b528199
PME_ADDRESS=0x5F047CCE438ae7796140506a5edf3D711034aaF3
POINTS_ADDRESS=0x52e1b275d7f925e48f74d304e6d7e8ca489de6b9
VAULT_ADDRESS=0x0730422E49B76A2D36d51304ACEcbe4f444821F8
SAFE_OWNER_ADDRESS=0x63E09ead6CcF8850287370B4b248B02D4D43e1Ba
# Same contract the sibling repo and this repo's upgrade script both mean by
# HOOK_ADDRESS (deprecated alias, mapped in update-futures.ts).
POINTS_HOOK_ADDRESS=0x81f47f6c84ffb1a5daa8c54989a4cb9458017188

# ── Subgraph manifests ─────────────────────────────────────────────────────
START_BLOCK_FUTURES=43744464

# ── Notifications runtime ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── UI (local `pnpm dev:prd` / `pnpm build:prd`; CI overlays URL and secrets)
REACT_APP_CHAIN_ID=8453
REACT_APP_ETHERSCAN_URL=https://basescan.org
REACT_APP_FUTURES_TOKEN_ADDRESS=0xf97a1bbfb5e061ef73dad8ebf25939d93639fb7f
REACT_APP_GITBOOK_URL=https://gitbook.lumerin.io/lumerin-hashpower-marketplace/buyer-web-marketplace/overview-web-marketplace
REACT_APP_MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
REACT_APP_PAYMENT_SLIPPAGE_PERCENT=1
REACT_APP_PERPS_TOKEN_ADDRESS=0x794f9e63b7666985256f1d2763ee24cc0b528199
# Goldsky LMN-Exchange rolling tags (same project as former STG-Exchange).
REACT_APP_SUBGRAPH_FUTURES_URL=https://api.goldsky.com/api/public/project_cmmz5dm4l7ocp01xng61y5nwr/subgraphs/hpow-futures/lmn-latest/gn
REACT_APP_SUBGRAPH_ORACLES_URL=https://api.goldsky.com/api/public/project_cmmz5dm4l7ocp01xng61y5nwr/subgraphs/hpow-oracles/lmn-latest/gn
REACT_APP_SUBGRAPH_PERPS_URL=https://api.goldsky.com/api/public/project_cmmz5dm4l7ocp01xng61y5nwr/subgraphs/hpow-derivatives/lmn-latest/gn
REACT_APP_SUBGRAPH_POINTS_URL=https://api.goldsky.com/api/public/project_cmmz5dm4l7ocp01xng61y5nwr/subgraphs/hpow-points/lmn-latest/gn
REACT_APP_USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
REACT_APP_URL=https://beta.hashpower.exchange
